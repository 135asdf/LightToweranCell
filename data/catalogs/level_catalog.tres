[gd_resource type="Resource" script_class="LevelCatalog" format=3]

[ext_resource type="Script" path="res://base/catalogs/level_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://base/catalogs/level_catalog_entry.gd" id="2_entry"]
[ext_resource type="PackedScene" path="res://scenes/levels/level_01.tscn" id="3_scene"]

[sub_resource type="Resource" id="entry_level_01"]
script = ExtResource("2_entry")
level_id = &"level_01"
display_name = "第 1 关"
scene = ExtResource("3_scene")
default_unlocked = true

[resource]
script = ExtResource("1_catalog")
entries = Array[ExtResource("2_entry")]([SubResource("entry_level_01")])
